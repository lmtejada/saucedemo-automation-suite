		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.10.5",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.5",
		"typescript-eslint": "^8.64.0"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix",
			"prettier --write"
