{
    "name": "saucedemo-automation-suite",
    "version": "1.0.0",
    "description": "SauceDemo UI & Hybrid Automation Suite",
    "author": "Laura Tejada",
    "license": "ISC",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "playwright test --grep-invert \"@visual|@problematic\"",
        "test:chromium": "playwright test --project=chromium --grep-invert @problematic",
        "test:firefox": "playwright test --project=firefox --grep-invert @problematic",
        "test:webkit": "playwright test --project=webkit --grep-invert @problematic",
        "test:smoke": "playwright test --grep @smoke --project=chromium",
        "test:regression": "playwright test --grep @regression --project=chromium",
        "test:e2e": "playwright test --grep @e2e --project=chromium",
        "test:a11y": "playwright test --grep @a11y",
        "test:visual": "playwright test --grep @visual",
        "test:problematic": "playwright test --grep @problematic --project=chromium --workers=1",
        "test:debug": "playwright test --project=chromium --debug",
        "test:ui": "playwright test --project=chromium --ui",
        "test:headed": "playwright test --project=chromium --headed --grep-invert @problematic",
        "test:ci": "npm test:regression && npm run test:e2e && npm run test:a11y",
        "test:nightly": "npm test && npm run test:visual && npm run test:problematic",
        "report": "playwright show-report",
        "codegen": "playwright codegen"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "typescript-eslint": "^8.64.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
