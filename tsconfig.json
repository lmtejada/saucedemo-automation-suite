{
    "compilerOptions": {
        /* -------------------------------------------------------------------------- */
        /* Path Aliases                                                               */
        /* -------------------------------------------------------------------------- */
        "paths": {
            "@fixtures/*": ["./src/fixtures/*"],
            "@enums/*": ["./src/enums/*"],
            "@test-data/*": ["./src/test-data/*"],
            "@utils/*": ["./src/utils/*"],
            "@pages/*": ["./src/pages/*"],
            "@app-types/*": ["./src/types/*"]
        },

        /* -------------------------------------------------------------------------- */
        /* Language & Environment Settings                                            */
        /* -------------------------------------------------------------------------- */
        "target": "ESNext",
        "lib": ["ESNext", "DOM"], // DOM is included for browser context typings in evaluate()
        "types": ["node"],

        /* -------------------------------------------------------------------------- */
        /* Modules & Resolution (NodeNext for ESM support)                            */
        /* -------------------------------------------------------------------------- */
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true, // Allows direct import of JSON test data
        "allowJs": true,
        "checkJs": false,

        /* -------------------------------------------------------------------------- */
        /* Emit & Build Output                                                        */
        /* -------------------------------------------------------------------------- */
        "rootDir": ".",
        "outDir": "./dist",
        "noEmit": true, // Playwright transpiles TS in-memory; no build files needed

        /* -------------------------------------------------------------------------- */
        /* Strict Type-Checking Guardrails                                            */
        /* -------------------------------------------------------------------------- */
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true // Speeds up compilation by skipping type checking of node_modules
    },

    /* -------------------------------------------------------------------------- */
    /* Scope & Exclusions                                                         */
    /* -------------------------------------------------------------------------- */
    "include": ["**/*.ts", "**/*.mts"],
    "exclude": [
        "node_modules",
        "dist",
        "playwright-report",
        "test-results",
        "blob-report"
    ]
}
